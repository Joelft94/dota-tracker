# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Discord webhook URL — Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Neon Postgres connection string (use the POOLED one, ends in -pooler)
DATABASE_URL=

# Optional: friends list as inline JSON. Overrides friends.json when set.
# Used by GitHub Actions so the list isn't committed to a public repo.
FRIENDS_JSON=

# Optional: timezone for the weekly recap window (default UTC)
TZ=UTC
